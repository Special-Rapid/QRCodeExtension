{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qr-handoff",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qr-handoff-prod",
      "database_id": "47ec50ec-4820-4bb1-b4fb-dbcba5407978",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR_DO",
        "class_name": "PairingRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairingRoom"]
    }
  ]
}
