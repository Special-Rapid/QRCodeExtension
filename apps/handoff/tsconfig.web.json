{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "web",
    "outDir": "public",
    "skipLibCheck": true,
    "paths": {
      "/notification-state.js": [
        "./web/notification-state.ts"
      ]
    }
  },
  "include": [
    "web/notification-state.ts",
    "web/app.ts"
  ]
}
