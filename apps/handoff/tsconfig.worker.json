{
  "compilerOptions": {
    "target": "ES2022",
    "module": "None",
    "moduleResolution": "Node10",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "declaration": false,
