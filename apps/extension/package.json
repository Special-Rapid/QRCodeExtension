{
  "name": "@qr-scan/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Camera-free QR Scan Chrome extension",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mts",
    "check": "npm run typecheck && npm run build && npm test",
    "pretest": "node ../../tooling/prepare-build-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build:tooling": "node ../../tooling/build-tooling.mts",
    "typecheck:tooling": "node ../../tooling/build-tooling.mts --noEmit",
    "typecheck:tooling-tests": "tsc --project ../../tooling/tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3"
  }
}
