{
  "manifest_version": 3,
  "name": "QR Scan — カメラ不要のQRコードリーダー",
  "version": "0.1.0",
  "description": "表示中のページまたは画像ファイルにあるQRコードを、カメラなしでローカル解析します。",
  "minimum_chrome_version": "121",
  "permissions": ["activeTab", "scripting", "notifications", "storage"],
  "host_permissions": ["https://qr.snkisk.com/*"],
  "background": {
    "service_worker": "handoff-background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://qr.snkisk.com/*"],
      "js": ["connector-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QR Scan"
  }
}
