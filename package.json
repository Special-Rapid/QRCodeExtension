{
  "name": "qrcodeextension",
  "version": "0.1.0",
  "private": true,
  "description": "Camera-free QR scanning and secure mobile-to-PC link handoff",
  "type": "module",
  "scripts": {
    "generate:brand-assets": "npm run build:tooling && node tooling/generate-brand-assets.mjs",
    "check:brand-assets": "npm run prepare:brand-assets && node tooling/generate-brand-assets.mjs --check",
    "build:extension": "npm --prefix apps/extension run build",
    "test:extension": "npm --prefix apps/extension run test",
    "check:extension": "npm run check:brand-assets && npm --prefix apps/extension run check",
    "check:handoff": "npm --prefix apps/handoff run check",
    "check:mobile": "npm --prefix apps/mobile run check",
    "check": "npm run test:build-assets && npm run check:extension && npm run check:handoff && npm run check:mobile",
    "prepare:brand-assets": "npm run build:tooling && node tooling/prepare-build-assets.mjs",
    "prepare:native-assets": "npm run build:tooling && node tooling/prepare-build-assets.mjs --native",
    "test:build-assets": "npm run build:tooling && node --test tooling/test/*.test.mjs",
    "build:tooling": "npm --prefix apps/extension run build:tooling",
    "typecheck:tooling": "npm --prefix apps/extension run typecheck:tooling"
  },
  "workspaces": [
    "apps/extension"
  ]
}
